    // -----------------------------
    // Load books from file
    // -----------------------------
    public static List<Book> loadBooks(String path) throws Exception {
        File file = new File(path);
        FileInputStream stream = new FileInputStream(file);
        Scanner fileScanner = new Scanner(stream);

        List<Book> books = new ArrayList<>();

        while (fileScanner.hasNextLine()) {
            String line = fileScanner.nextLine();
            String[] parts = line.split(",");

            if (parts.length >=7) {
            	 String bookId = parts[0].trim(); // removes clear space
            	 String bookIsbn = parts[1].trim();
            	 String title = parts[2].trim();
            	 String author = parts[3].trim();
            	 String dateOfpublication = parts[4].trim(); // still gives null value issue
            	 String genre = parts[5].trim();
            	 String ageRating = parts[6].trim();

                Book b = new Book(parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], parts[6]) ;
                books.add(b);
            }
        }

        fileScanner.close();
        stream.close();

        return books;
    }

    // -----------------------------
    // Load members from file
    // -----------------------------
    public static List<Member> loadMembers(String path) throws Exception {
        File file = new File(path);
        FileInputStream stream = new FileInputStream(file);
        Scanner fileScanner = new Scanner(stream);

        List<Member> members = new ArrayList<>();

        while (fileScanner.hasNextLine()) {
            String line = fileScanner.nextLine();
            String[] parts = line.split(",");

            if (parts.length >= 2) {
                Member m = new Member(parts[0], parts[1]);
                members.add(m);
            }
        }

        fileScanner.close();
        stream.close();

        return members;
    }

    // -----------------------------
    // Find book by ID
    // -----------------------------
    public static Book findBook(List<Book> books, String id) {
        for (Book b : books) {
            if (b.bookId.equals(id)) {
                return b;
            }
        }
        return null;
    }
